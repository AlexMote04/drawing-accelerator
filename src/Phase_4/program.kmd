KMD
00000000:             ; ; -----------------------------------------------------------------------------
00000000:             ; ; Constant Definitions
00000000:             ; ; -----------------------------------------------------------------------------
00000000:             ; DRAW_BASE equ    0x00010800   ; Base address of Drawing Engine
00000000:             ; REG_R0 equ       0x00         ; Register 0 (X Coord / Clear Colour)
00000000:             ; REG_R1 equ       0x04         ; Register 1 (Y Coord)
00000000:             ; REG_R4 equ       0x10         ; Register 4 (Radius)
00000000:             ; REG_R6 equ       0x18         ; Register 6 (Colour)
00000000:             ; REG_CMD equ      0x20         ; Command Register (Write Only)
00000000:             ; REG_STATUS equ   0x24         ; Status Register (Read Only)
00000000:             ; REG_S_CLR equ    0x28         ; Status Clear Register (Write Only)
00000000:             ; 
00000000:             ; UNIT_CLEAR equ   0            ; Unit ID for Clear Screen
00000000:             ; UNIT_CIRCLE equ   2            ; Unit ID for Circle Drawer
00000000:             ; 
00000000:             ; ; -----------------------------------------------------------------------------
00000000:             ; ; Main Program
00000000:             ; ; -----------------------------------------------------------------------------
00000000:             ; main:
00000000: 00011437    ;     li s0, DRAW_BASE           ; Load Base Address into s0 (used globally)
00000004: 80040413    ; 
00000008:             ; 
00000008:             ;     ; -----------------------------------------
00000008:             ;     ; 1. Initialization: Clear the Screen
00000008:             ;     ; -----------------------------------------
00000008:             ;     ; Set Background Colour to Black (0x00)
00000008: 00000293    ;     li t0, 0x00
0000000C: 00542023    ;     sw t0, REG_R0[s0]          ; Write 0 to R0
00000010:             ;     
00000010:             ;     ; Trigger Clear Unit
00000010: 00000293    ;     li t0, UNIT_CLEAR
00000014: 02542023    ;     sw t0, REG_CMD[s0]         ; Write 0 to Command Register
00000018:             ;     
00000018:             ;     ; Wait for Clear to finish
00000018: 0B4000EF    ;     jal wait_for_done
0000001C:             ; 
0000001C:             ;     ; -----------------------------------------
0000001C:             ;     ; 2. Draw Concentric Circles
0000001C:             ;     ; -----------------------------------------
0000001C:             ;     
0000001C:             ;     ; --- Circle 1: Big Red ---
0000001C:             ;     ; Center (320, 240), Radius 150, Colour Red (0xE0)
0000001C: 14000293    ;     li t0, 320
00000020: 00542023    ;     sw t0, REG_R0[s0]          ; Set X
00000024: 0F000293    ;     li t0, 240
00000028: 00542223    ;     sw t0, REG_R1[s0]          ; Set Y
0000002C: 09600293    ;     li t0, 150
00000030: 00542823    ;     sw t0, REG_R4[s0]          ; Set Radius
00000034: 0E000293    ;     li t0, 0xE0
00000038: 00542C23    ;     sw t0, REG_R6[s0]          ; Set Colour (Red)
0000003C:             ;     
0000003C: 00200293    ;     li t0, UNIT_CIRCLE
00000040: 02542023    ;     sw t0, REG_CMD[s0]         ; GO
00000044: 088000EF    ;     jal wait_for_done
00000048:             ; 
00000048:             ;     ; --- Circle 2: Medium Green ---
00000048:             ;     ; Center (320, 240), Radius 100, Colour Green (0x1C)
00000048: 14000293    ;     li t0, 320
0000004C: 00542023    ;     sw t0, REG_R0[s0]          ; X is unchanged, but safer to rewrite
00000050: 0F000293    ;     li t0, 240
00000054: 00542223    ;     sw t0, REG_R1[s0]          ; Y is unchanged
00000058: 06400293    ;     li t0, 100
0000005C: 00542823    ;     sw t0, REG_R4[s0]          ; New Radius
00000060: 01C00293    ;     li t0, 0x1C
00000064: 00542C23    ;     sw t0, REG_R6[s0]          ; New Colour (Green)
00000068:             ;     
00000068: 00200293    ;     li t0, UNIT_CIRCLE
0000006C: 02542023    ;     sw t0, REG_CMD[s0]         ; GO
00000070: 05C000EF    ;     jal wait_for_done
00000074:             ; 
00000074:             ;     ; --- Circle 3: Small Blue ---
00000074:             ;     ; Center (320, 240), Radius 50, Colour Blue (0x03)
00000074: 14000293    ;     li t0, 320
00000078: 00542023    ;     sw t0, REG_R0[s0]
0000007C: 0F000293    ;     li t0, 240
00000080: 00542223    ;     sw t0, REG_R1[s0]
00000084: 03200293    ;     li t0, 50
00000088: 00542823    ;     sw t0, REG_R4[s0]
0000008C: 00300293    ;     li t0, 0x03
00000090: 00542C23    ;     sw t0, REG_R6[s0]
00000094:             ;     
00000094: 00200293    ;     li t0, UNIT_CIRCLE
00000098: 02542023    ;     sw t0, REG_CMD[s0]         ; GO
0000009C: 030000EF    ;     jal wait_for_done
000000A0:             ; 
000000A0:             ;     ; -----------------------------------------
000000A0:             ;     ; 3. Corner Test (Verifies Coordinate Limits)
000000A0:             ;     ; -----------------------------------------
000000A0:             ;     ; Draw a White Circle at Top-Left (0,0) with Radius 30
000000A0: 00000293    ;     li t0, 0
000000A4: 00542023    ;     sw t0, REG_R0[s0]          ; X = 0
000000A8: 00542223    ;     sw t0, REG_R1[s0]          ; Y = 0
000000AC: 01E00293    ;     li t0, 30
000000B0: 00542823    ;     sw t0, REG_R4[s0]          ; Radius = 30
000000B4: 0FF00293    ;     li t0, 0xFF
000000B8: 00542C23    ;     sw t0, REG_R6[s0]          ; Colour = White (0xFF)
000000BC:             ;     
000000BC: 00200293    ;     li t0, UNIT_CIRCLE
000000C0: 02542023    ;     sw t0, REG_CMD[s0]         ; GO
000000C4: 008000EF    ;     jal wait_for_done
000000C8:             ; 
000000C8:             ;     ; -----------------------------------------
000000C8:             ;     ; 4. End of Program
000000C8:             ;     ; -----------------------------------------
000000C8:             ; done:
000000C8: 0000006F    ;     j done                     ; Infinite loop to stop processor
000000CC:             ; 
000000CC:             ; ; -----------------------------------------------------------------------------
000000CC:             ; ; Subroutine: wait_for_done
000000CC:             ; ; Description: Polls the Status Register until Bit 8 (Done) is set, 
000000CC:             ; ;              then clears the bit.
000000CC:             ; ; -----------------------------------------------------------------------------
000000CC:             ; wait_for_done:
000000CC: 02442303    ;     lw   t1, REG_STATUS[s0]    ; Read Status Register (Offset 0x24)
000000D0: 10037313    ;     andi t1, t1, 0x100         ; Mask Bit 8 (0x100 is the 'Done' bit)
000000D4: FE030CE3    ;     beqz t1, wait_for_done     ; If result is 0, unit is busy -> loop back
000000D8:             ;     
000000D8:             ;     ; If we are here, the unit is done. Acknowledge the interrupt.
000000D8: 10000313    ;     li   t1, 0x100
000000DC: 02642423    ;     sw   t1, REG_S_CLR[s0]     ; Write 1 to Bit 8 of Status Clear (Offset 0x28)
000000E0: 00008067    ;     ret

